// use prisma-8

/// How a participant can make a given block: a plain yes, or if they are needed.
enum AvailabilityStatus {
  @@type("pg/text@1")
  yes        = "yes"
  if_need_be = "if_need_be"
}

model User {
  id             Uuid           @id @default(uuid(7))
  name           String
  email          String?        @unique

  createdEvents  Event[]
}

model Event {
  id             Uuid           @id @default(uuid(7))
  title          String
  description    String?
  timezone       String         @default("Europe/Lisbon")

  // The specific days the creator picked
  proposedDates  Date[]

  // The daily hours (e.g. "09:00" to "17:00"). If null, it means any time of day is allowed.
  startTime      String?
  endTime        String?

  finalStartTime DateTime?
  finalEndTime   DateTime?

  // Optional for the MVP so anyone can create an event frictionlessly
  creatorId      Uuid?
  creator        User?          @relation(fields: [creatorId], references: [id])

  participants   Participant[]
  availabilities Availability[]

  createdAt      DateTime       @default(now())
}

/// A guest's response to one event. There are no accounts in the MVP, so this is
/// event-scoped: the same person can answer different events with different names.
model Participant {
  id             Uuid       @id @default(uuid(7))
  name           String

  eventId        Uuid
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  availabilities Availability[]

  createdAt      DateTime   @default(now())

  @@index([eventId])
}

model Availability {
  id            Int              @id @default(autoincrement())

  startTime     DateTime
  endTime       DateTime
  status        AvailabilityStatus @default(yes)

  eventId       Uuid
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  participantId Uuid
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([participantId])
}
