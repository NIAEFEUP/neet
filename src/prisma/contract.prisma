// use prisma-8

/// How a participant can make a given block: a plain yes, or if they are needed.
enum AvailabilityStatus {
  @@type("pg/text@1")
  yes        = "yes"
  if_need_be = "if_need_be"
}

model User {
  id             String         @id @default(uuid(7)) // Better Auth supplies ids for auth-created users; the default covers direct creates (seed)
  name           String
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      temporal.updatedAt()

  sessions       Session[]
  accounts       Account[]
  createdEvents  Event[]
  participants   Participant[]
}

model Event {
  id             Uuid           @id @default(uuid(7))
  title          String
  description    String?
  timezone       String         @default("Europe/Lisbon")

  // The specific days the creator picked
  proposedDates  Date[]

  // The daily hours (e.g. "09:00" to "17:00"). If null, it means any time of day is allowed.
  startTime      String?
  endTime        String?

  finalStartTime DateTime?
  finalEndTime   DateTime?

  // Optional for the MVP so anyone can create an event frictionlessly
  creatorId      String?
  creator        User?          @relation(fields: [creatorId], references: [id])

  participants   Participant[]
  availabilities Availability[]

  createdAt      DateTime       @default(now())
}

/// A member's response to one event. Identity is the signed-in account: one
/// response per member per event, and `name` is a snapshot of their account
/// name so the responses list needs no join.
model Participant {
  id             Uuid       @id @default(uuid(7))
  name           String

  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId        Uuid
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  availabilities Availability[]

  createdAt      DateTime   @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

model Availability {
  id            Int              @id @default(autoincrement())

  startTime     DateTime
  endTime       DateTime
  status        AvailabilityStatus @default(yes)

  eventId       Uuid
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  participantId Uuid
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([participantId])
}

model Session {
  id        String   @id // id is generated by Better Auth, not the database
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime // default is computed by Better Auth on write
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id // id is generated by Better Auth, not the database
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  // default is computed by Better Auth on write
  updatedAt             temporal.updatedAt()
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id // id is generated by Better Auth, not the database
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime // default is computed by Better Auth on write
  updatedAt  temporal.updatedAt() // default is computed by Better Auth on write

  @@index([identifier])
  @@map("verification")
}
