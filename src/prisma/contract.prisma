// use prisma-8

model User {
  id             Uuid           @id @default(uuid(7))
  name           String
  email          String?        @unique
  
  createdEvents  Event[]
  availabilities Availability[]
}

model Event {
  id             Uuid           @id @default(uuid(7))
  title          String
  description    String?
  timezone       String         @default("Europe/Lisbon")
  
  // The specific days the creator picked
  proposedDates  Date[]
  
  // The daily hours (e.g. "09:00" to "17:00"). If null, it means any time of day is allowed.
  startTime      String?
  endTime        String?
  
  finalStartTime DateTime?
  finalEndTime   DateTime?
  
  // Optional for the MVP so anyone can create an event frictionlessly
  creatorId      Uuid?
  creator        User?          @relation(fields: [creatorId], references: [id])
  
  availabilities Availability[]
  
  createdAt      DateTime       @default(now())
}

model Availability {
  id             Int            @id @default(autoincrement())
  
  startTime      DateTime
  endTime        DateTime
  
  eventId        Uuid
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId         Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}
