// use prisma-8

model Event {
  id          String             @id @default(uuid())
  slug        String             @unique
  title       String
  description String?
  startDate   DateString
  endDate     DateString
  startTime   String?
  endTime     String?
  timezone    String
  createdAt   TimestampString(3) @default(now())

  @@map("events")
}
